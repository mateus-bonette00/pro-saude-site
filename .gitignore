# =============================================================================
*.orig
*.rej
*.bak
*.tmp
*.temp
.npm
.node_repl_history
.yarn-integrity
.grunt
.lock-wscript
.wafpickle-*
.envrc
.direnv/
.tool-versions.local

# Arquivos de backup do editor
*~
*.swp
*.swo

# Sentry / monitoramento local
.sentryclirc

# Lighthouse / performance reports locais
lighthouse-report.*
.lighthouseci/
