yarn.lock
bun.lock
bun.lockb
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions


# =============================================================================
# Next.js — build, cache e export estático
# =============================================================================
.next/
out/
build/
dist/
.vercel/
.netlify/

.turbo/
next-dev.log
*.tsbuildinfo


# =============================================================================
